{
  "name": "fastolearn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FastoLearn — Türkçeden Almancaya (A1) hızlı kelime öğrenme. RWKV-Instant tabanlı kişiselleştirme + FSRS-7 aralıklı tekrar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "deck:check": "node scripts/validate-deck.mjs",
    "check": "tsc -b --noEmit false --emitDeclarationOnly false || true"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
